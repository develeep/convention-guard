{
  "description": "변경 파일 수집(PostToolUse) + 완료 시점 컨벤션 검증 사이클(Stop). 의미 판정은 후보가 있을 때만 convention-reviewer 에이전트에 위임합니다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/collect.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/collect.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check.py\"",
            "timeout": 150,
            "statusMessage": "컨벤션 검사 중..."
          }
        ]
      }
    ]
  }
}
