# `tests/run_all.py` 는 스위트를 서브프로세스로 띄웁니다. 자식이 스스로 측정을
# 시작하려면 COVERAGE_PROCESS_START 가 **존재하는** 설정 파일을 가리켜야 합니다.
# 이 파일이 없으면 측정이 조용히 부모 프로세스만 담아 실제보다 크게 낮게 나옵니다.
# 통합 테스트는 자식을 임시 디렉터리에서 띄우므로 COVERAGE_FILE 로 데이터 경로를
# 절대 경로로 고정해야 합니다 — 아니면 자식의 측정치가 그 임시 디렉터리에 남습니다.
[run]
parallel = true
# `source` 를 두지 않는 이유: 상대 경로는 임시 디렉터리에서 도는 자식에게 존재하지
# 않는 경로가 되어 그 자식이 아무것도 담지 않습니다. 범위는 보고 단계에서 좁힙니다.
[report]
omit = */site-packages/*, */lib/python3*/*
